
public class MattressSalesReport {

    public static void main(String[] args) {

        // Single array storing product names
        String[] products = {"Single Mattress", "Double Mattress", "Queen Mattress"};

        // Two-dimensional array storing sales for 3 months
        int[][] sales = {
            {25, 18, 20},
            {15, 10, 12},
            {18, 15, 20}
        };

        int total = 0;
        int max = 0;
        int popular = 0;

        // Calculate total sales for each product
        for (int i = 0; i < sales.length; i++) {

            int productTotal = 0;

            for (int j = 0; j < sales[i].length; j++) {
                productTotal += sales[i][j];
                total += sales[i][j];
            }

            System.out.println(products[i] + ": " + productTotal);

            // Find the most popular product
            if (productTotal > max) {
                max = productTotal;
                popular = i;
            }
        }

        // Calculate average sales per product
        double average = (double) total / products.length;

        // Display report
        System.out.println("\nMATTRESS SALES REPORT");
        System.out.println("--------------------");
        System.out.println("Total products sold: " + total);
        System.out.println("Average per product: " + average);
        System.out.println("Most popular product: " + products[popular]);
        System.out.println("Highest sales: " + max);
    }
}
